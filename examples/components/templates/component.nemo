<!--
  component.nemo — the shared layout template for component reference pages in
  the gallery.

  Every component page is laid out identically:

    <component-page name="Button"
                    description="A clickable button that triggers actions.">

      One or more example blocks (<component-example>). Untargeted children of
      <component-page> land in the Examples region.

      <component-example label="Variants">
        <button label="Primary" variant="primary" />
        ...
      </component-example>

      Optional: property reference rows (Name | Type | Default | Description),
      authored as `<text>` rows or a declared `<table>`.

    </component-page>

  The template supplies the page chrome (H1 + description + the
  Preview/Code tab pair per section) so individual pages declare only content.
-->
<props>
  <prop name="name" type="string" required="true" />
  <prop name="description" type="string" default="" />
</props>

<template name="component-page">
  <!-- IMPORTANT: every child of an SFC template needs an explicit id. Id-less
       children get parse-time `__anon_N` keys that are identical for every
       instance of this file; the flat id-keyed component map then collapses
       chrome across instances/pages (dropped headings, children escaping
       slots, empty named-slot panels). See docs/knowledgebase/plans/sfc-anon-ids.md. -->
  <stack id="page_root" direction="vertical" spacing="24" padding="16">
    <label id="page_title" text="${name}" size="xl" />
    <text id="page_desc">${description}</text>
    <panel id="page_examples_panel">
      <stack id="page_examples" direction="vertical" spacing="24" padding="24">
        <label id="page_examples_label" text="Examples" size="lg" />
        <stack id="page_examples_slot" direction="vertical" spacing="12">
          <slot required="true" />
        </stack>
      </stack>
    </panel>
    <panel id="page_properties_panel">
      <stack id="page_properties" direction="vertical" spacing="24" padding="24">
        <label id="page_properties_label" text="Properties" size="lg" />
        <stack id="page_properties_slot" direction="vertical" spacing="8">
          <slot name="properties" />
        </stack>
      </stack>
    </panel>
    <panel id="page_callbacks_panel">
      <stack id="page_callbacks" direction="vertical" spacing="24" padding="24">
        <label id="page_callbacks_label" text="Callbacks" size="lg" />
        <stack id="page_callbacks_slot" direction="vertical" spacing="8">
          <slot name="callbacks" />
        </stack>
      </stack>
    </panel>
  </stack>
</template>
