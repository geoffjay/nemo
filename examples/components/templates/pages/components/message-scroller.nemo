<!-- message-scroller.nemo — placeholder page for the gpui-kit Message Scroller component. Not yet
     wrapped by nemo; the status block below goes away once examples are added. -->
<template name="component-page-message-scroller">
  <component-page name="Message Scroller" description="A virtualized scroller purpose-built for message lists.">
    <stack id="message_scroller_status" direction="vertical" spacing="4" align="start">
      <label id="message_scroller_not_implemented" text="Not implemented" size="lg" />
      <label id="message_scroller_source" text="Source: https://gpui-kit.com/component/message-scroller" size="sm" />
    </stack>
  </component-page>
</template>
