<script>
let basic_code = #"<stack direction="vertical" spacing="16">
  <bubble alignment="start" variant="secondary" text="Can you review this draft?" />
  <bubble alignment="end" text="Done — comments in the doc." />
</stack>"#;

let variants_code = #"<bubble alignment="start" text="Primary response" />
<bubble alignment="start" variant="secondary" text="Neutral incoming response" />
<bubble alignment="start" variant="muted" text="Low-emphasis context" />
<bubble alignment="start" variant="tinted" text="Subtle selected response" />
<bubble alignment="start" variant="outline" text="Needs a visible boundary" />"#
;

let destructive_code = #"<bubble alignment="end" variant="destructive" text="The push failed; retry under Settings → Sync." />"#;

let ghost_code = #"<bubble variant="ghost" text="Markdown replies and rich content render without a surface; shadows and overhanging controls stay visible." />"#;

let group_code = #"<bubble-group>
  <bubble alignment="start" variant="secondary" text="First paragraph from Alice." />
  <bubble alignment="start" variant="secondary" text="Second paragraph, same sender." />
  <bubble alignment="start" variant="secondary" text="Third paragraph, same sender." />
</bubble-group>"#;

let reactions_code = #"<bubble alignment="start" variant="outline" text="This response has feedback.">
  <bubble-reactions side="bottom" alignment="start">
    <label text="👍 2" />
  </bubble-reactions>
</bubble>

<bubble alignment="end" text="Running late!">
  <bubble-reactions side="top" alignment="end">
    <label text="💬 1" />
  </bubble-reactions>
</bubble>"#;
</script>

<!-- bubble.nemo — component reference page for the bubble wrapper of
     gpui-kit's Bubble. The bubble owns alignment, variants, and the reaction
     region; text goes through the text attribute, rich content through
     arbitrary children, reactions through a <bubble-reactions> child. -->
<template name="component-page-bubble">
  <component-page name="Bubble" description="Chat bubbles with visual variants and optional reaction feedback. The bubble owns alignment and max width (80% of its parent); the plain text or arbitrary children are its content.">
    <component-example label="Basic Conversation">
      <stack id="bubble_basic_stack" direction="vertical" spacing="16">
        <bubble id="bubble_incoming" alignment="start" variant="secondary" text="Can you review this draft?" />
        <bubble id="bubble_outgoing" alignment="end" text="Done — comments in the doc." />
      </stack>
      <code-editor
        id="bubble_code_basic"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="5"
        default-value="{{ basic_code }}"
      />
    </component-example>

    <component-example label="Variants">
      <stack id="bubble_variants_stack" direction="vertical" spacing="8" align="start">
        <bubble id="bubble_v_filled" alignment="start" text="Primary response" />
        <bubble id="bubble_v_secondary" alignment="start" variant="secondary" text="Neutral incoming response" />
        <bubble id="bubble_v_muted" alignment="start" variant="muted" text="Low-emphasis context" />
        <bubble id="bubble_v_tinted" alignment="start" variant="tinted" text="Subtle selected response" />
        <bubble id="bubble_v_outline" alignment="start" variant="outline" text="Needs a visible boundary" />
      </stack>
      <code-editor
        id="bubble_code_variants"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="6"
        default-value="{{ variants_code }}"
      />
    </component-example>

    <component-example label="Destructive and Ghost">
      <stack id="bubble_states_stack" direction="vertical" spacing="16" align="start">
        <bubble id="bubble_failed" alignment="end" variant="destructive" text="The push failed; retry under Settings → Sync." />
        <bubble id="bubble_ghost" variant="ghost" text="Markdown replies and rich content render without a surface; shadows and overhanging controls stay visible." />
      </stack>
      <code-editor
        id="bubble_code_states"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="3"
        default-value="{{ ghost_code }}"
      />
    </component-example>

    <component-example label="Group">
      <bubble-group id="bubble_group_example">
        <bubble id="bubble_group_one" alignment="start" variant="secondary" text="First paragraph from Alice." />
        <bubble id="bubble_group_two" alignment="start" variant="secondary" text="Second paragraph, same sender." />
        <bubble id="bubble_group_three" alignment="start" variant="secondary" text="Third paragraph, same sender." />
      </bubble-group>
      <code-editor
        id="bubble_code_group"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="6"
        default-value="{{ group_code }}"
      />
    </component-example>

    <component-example label="Reactions">
      <stack id="bubble_reactions_stack" direction="vertical" spacing="24" width="420">
        <bubble id="bubble_rx_bottom" alignment="start" variant="outline" text="This response has feedback.">
          <bubble-reactions id="bubble_rx_bottom_region" side="bottom" alignment="start">
            <label id="bubble_rx_bottom_label" text="👍 2" />
          </bubble-reactions>
        </bubble>
        <bubble id="bubble_rx_top" alignment="end" text="Running late!">
          <bubble-reactions id="bubble_rx_top_region" side="top" alignment="end">
            <label id="bubble_rx_top_label" text="💬 1" />
          </bubble-reactions>
        </bubble>
      </stack>
      <code-editor
        id="bubble_code_reactions"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="16"
        default-value="{{ reactions_code }}"
      />
    </component-example>

    <table slot="properties" stripe="true">
      <table-header>
        <table-column field="name" width="130">Attribute</table-column>
        <table-column field="type" width="90">Type</table-column>
        <table-column field="default" width="110">Default</table-column>
        <table-column field="description" width="560">Description</table-column>
      </table-header>
      <table-row>
        <table-cell><label size="sm" text="text" /></table-cell>
        <table-cell>string</table-cell>
        <table-cell>—</table-cell>
        <table-cell>Plain-text content; arbitrary child elements compose rich content next to it.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="alignment" /></table-cell>
        <table-cell>string</table-cell>
        <table-cell>—</table-cell>
        <table-cell>Row placement: start (incoming) or end (outgoing). Unset when a parent (e.g. Message) owns placement.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="variant" /></table-cell>
        <table-cell>string</table-cell>
        <table-cell>filled</table-cell>
        <table-cell>Surface treatment: filled, secondary, muted, tinted, outline, ghost (no surface, full width), or destructive.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="bubble-reactions" /></table-cell>
        <table-cell>element</table-cell>
        <table-cell>—</table-cell>
        <table-cell>Optional child pill on the bubble edge; its side (top/bottom) and alignment (start/end) position it along the bubble.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="bubble-group" /></table-cell>
        <table-cell>element</table-cell>
        <table-cell>—</table-cell>
        <table-cell>Vertical stack for consecutive bubbles from one sender; supplies the shared spacing rhythm.</table-cell>
      </table-row>
    </table>
  </component-page>
</template>
