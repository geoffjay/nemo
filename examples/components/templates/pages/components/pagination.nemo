<!-- pagination.nemo — placeholder page for the gpui-kit Pagination component. Not yet
     wrapped by nemo; the status block below goes away once examples are added. -->
<template name="component-page-pagination">
  <component-page name="Pagination" description="Page navigation with an ellipsis menu that lists hidden pages.">
    <stack id="pagination_status" direction="vertical" spacing="4" align="start">
      <label id="pagination_not_implemented" text="Not implemented" size="lg" />
      <label id="pagination_source" text="Source: https://gpui-kit.com/component/pagination" size="sm" />
    </stack>
  </component-page>
</template>
