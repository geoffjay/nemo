<script>
let basic_code = #"<kbd id="kbd_palette" keys="cmd-shift-p" />
<kbd id="kbd_new_tab" keys="cmd-t" />
<kbd id="kbd_save" keys="cmd-s" />"#;

let modifiers_code = #"<kbd id="kbd_zoom_out" keys="cmd--" />
<kbd id="kbd_zoom_in" keys="cmd-+" />
<kbd id="kbd_backspace" keys="cmd-alt-backspace" />
<kbd id="kbd_a" keys="ctrl-shift-a" />"#;

let navigation_code = #"<kbd id="kbd_escape" keys="escape" />
<kbd id="kbd_enter" keys="enter" />
<kbd id="kbd_left" keys="left" />
<kbd id="kbd_up" keys="up" />
<kbd id="kbd_f12" keys="f12" />"#;

let outline_code = #"<kbd id="kbd_outline" keys="cmd-k" outline="true" />
<kbd id="kbd_outline_quit" keys="cmd-q" outline="true" />"#;
</script>

<!-- kbd.nemo — component reference page for the kbd wrapper of gpui-kit's
     Kbd. Platform-specific formatting (macOS symbols / text labels elsewhere)
     comes from the component itself; this page shows the variants. -->
<template name="component-page-kbd">
  <component-page name="Kbd" description="A tag for displaying keyboard keybindings. Formatted per platform: macOS uses symbols (⌘⇧P), Windows/Linux text labels (Ctrl+Shift+P).">
    <component-example label="Common Shortcuts">
      <stack id="kbd_basic_row" direction="horizontal" spacing="16">
        <kbd id="kbd_palette" keys="cmd-shift-p" />
        <kbd id="kbd_new_tab" keys="cmd-t" />
        <kbd id="kbd_save" keys="cmd-s" />
        <kbd id="kbd_find" keys="cmd-shift-f" />
      </stack>
      <code-editor
        id="kbd_code_basic"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="4"
        default-value="{{ basic_code }}"
      />
    </component-example>

    <component-example label="Modifiers">
      <stack id="kbd_modifiers_row" direction="horizontal" spacing="16">
        <kbd id="kbd_zoom_out" keys="cmd--" />
        <kbd id="kbd_zoom_in" keys="cmd-+" />
        <kbd id="kbd_backspace" keys="cmd-alt-backspace" />
        <kbd id="kbd_a" keys="ctrl-shift-a" />
      </stack>
      <code-editor
        id="kbd_code_modifiers"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="5"
        default-value="{{ modifiers_code }}"
      />
    </component-example>

    <component-example label="Navigation and Function Keys">
      <stack id="kbd_navigation_row" direction="horizontal" spacing="16">
        <kbd id="kbd_escape" keys="escape" />
        <kbd id="kbd_enter" keys="enter" />
        <kbd id="kbd_left" keys="left" />
        <kbd id="kbd_up" keys="up" />
        <kbd id="kbd_f12" keys="f12" />
      </stack>
      <code-editor
        id="kbd_code_navigation"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="6"
        default-value="{{ navigation_code }}"
      />
    </component-example>

    <component-example label="Outline Style">
      <stack id="kbd_outline_row" direction="horizontal" spacing="16" align="center">
        <label id="kbd_outline_label" text="Command palette:" />
        <kbd id="kbd_outline" keys="cmd-k" outline="true" />
        <kbd id="kbd_outline_quit" keys="cmd-q" outline="true" />
      </stack>
      <code-editor
        id="kbd_code_outline"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="3"
        default-value="{{ outline_code }}"
      />
    </component-example>

    <table slot="properties" stripe="true">
      <table-header>
        <table-column field="name" width="120">Attribute</table-column>
        <table-column field="type" width="90">Type</table-column>
        <table-column field="default" width="110">Default</table-column>
        <table-column field="description" width="560">Description</table-column>
      </table-header>
      <table-row>
        <table-cell><label size="sm" text="keys" /></table-cell>
        <table-cell>string</table-cell>
        <table-cell>cmd-k</table-cell>
        <table-cell>Keystroke in gpui keymap syntax, e.g. <text>cmd-shift-p</text>, <text>escape</text>, <text>pageup</text>. Formatted per platform: macOS symbols (⌘⇧P), Windows/Linux labels (Ctrl+Shift+P).</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="outline" /></table-cell>
        <table-cell>bool</table-cell>
        <table-cell>false</table-cell>
        <table-cell>Render in outline style (border, page background) instead of the muted filled tag.</table-cell>
      </table-row>
    </table>
  </component-page>
</template>