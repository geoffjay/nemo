<!-- kbd.nemo — placeholder page for the gpui-kit Kbd component. Not yet
     wrapped by nemo; the status block below goes away once examples are added. -->
<template name="component-page-kbd">
  <component-page name="Kbd" description="A tag for displaying keyboard keybindings.">
    <stack id="kbd_status" direction="vertical" spacing="4" align="start">
      <label id="kbd_not_implemented" text="Not implemented" size="lg" />
      <label id="kbd_source" text="Source: https://gpui-kit.com/component/kbd" size="sm" />
    </stack>
  </component-page>
</template>
