<script>
let sizes_code = #"<spinner size="xs" />
<spinner size="sm" />
<spinner size="md" />
<spinner size="lg" />"#;
</script>

<template name="component-page-spinner">
  <component-page name="Spinner" description="A loading spinner indicator. Available sizes: xs, sm, md (default), lg, xl.">
    <component-example label="Sizes">
      <stack direction="horizontal" spacing="24">
        <spinner id="spinner_xs" size="xs" />
        <spinner id="spinner_sm" size="sm" />
        <spinner id="spinner_md" />
        <spinner id="spinner_lg" size="lg" />
      </stack>
      <code-editor
        id="spinner_code_sizes"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="8"
        default-value="{{ sizes_code }}"
      />
    </component-example>

    <table slot="properties" stripe="true">
      <table-header>
        <table-column field="name" width="140">Attribute</table-column>
        <table-column field="type" width="90">Type</table-column>
        <table-column field="default" width="110">Default</table-column>
        <table-column field="description" width="520">Description</table-column>
      </table-header>
      <table-row>
        <table-cell><label size="sm" text="size" /></table-cell>
        <table-cell>string</table-cell>
        <table-cell>"md"</table-cell>
        <table-cell>Spinner size: xs, sm, md, lg, xl.</table-cell>
      </table-row>
    </table>
  </component-page>
</template>