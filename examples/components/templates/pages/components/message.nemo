<!-- message.nemo — placeholder page for the gpui-kit Message component. Not yet
     wrapped by nemo; the status block below goes away once examples are added. -->
<template name="component-page-message">
  <component-page name="Message" description="Composable chat message rows with avatar, header, content, and footer slots.">
    <stack id="message_status" direction="vertical" spacing="4" align="start">
      <label id="message_not_implemented" text="Not implemented" size="lg" />
      <label id="message_source" text="Source: https://gpui-kit.com/component/message" size="sm" />
    </stack>
  </component-page>
</template>
