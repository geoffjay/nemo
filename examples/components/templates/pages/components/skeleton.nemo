<script>
let basic_code = #"<skeleton id="loading_bar" />"#;

let text_lines_code = #"<skeleton id="line_1" width="250" rounded="md" />
<skeleton id="line_2" width="200" rounded="md" />
<skeleton id="line_3" width="180" rounded="md" />"#;

let profile_code = #"<stack direction="horizontal" spacing="16">
  <skeleton id="avatar" width="48" height="48" rounded="full" />
  <stack direction="vertical" spacing="8">
    <skeleton id="name" width="120" rounded="md" />
    <skeleton id="email" width="100" rounded="md" />
  </stack>
</stack>

<skeleton id="card_image" width="250" height="125" rounded="md" />"#;

let secondary_code = #"<skeleton id="subtle_bar" width="200" secondary="true" />
<skeleton id="subtle_line" width="180" secondary="true" />"#;
</script>

<!-- skeleton.nemo — component reference page for the skeleton wrapper of
     gpui-kit's Skeleton. The 2 s pulse animation is built into the component;
     sizing comes from the universal width/height/rounded attributes. -->
<template name="component-page-skeleton">
  <component-page name="Skeleton" description="A skeleton loading placeholder: a pulsing bar sized through width/height/rounded, in the theme skeleton color with a built-in 2s pulse animation.">
    <component-example label="Basic">
      <skeleton id="skeleton_basic_bar" />
      <code-editor
        id="skeleton_code_basic"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="2"
        default-value="{{ basic_code }}"
      />
    </component-example>

    <component-example label="Text Lines">
      <stack id="skeleton_lines_stack" direction="vertical" spacing="8" align="start">
        <skeleton id="skeleton_line_1" width="250" rounded="md" />
        <skeleton id="skeleton_line_2" width="200" rounded="md" />
        <skeleton id="skeleton_line_3" width="180" rounded="md" />
      </stack>
      <code-editor
        id="skeleton_code_text_lines"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="5"
        default-value="{{ text_lines_code }}"
      />
    </component-example>

    <component-example label="Circle and Rect Placeholders">
      <stack id="skeleton_shapes_stack" direction="vertical" spacing="16">
        <stack id="skeleton_profile_row" direction="horizontal" spacing="16">
          <skeleton id="skeleton_avatar" width="48" height="48" rounded="full" />
          <stack id="skeleton_profile_text" direction="vertical" spacing="8">
            <skeleton id="skeleton_name" width="120" rounded="md" />
            <skeleton id="skeleton_email" width="100" rounded="md" />
          </stack>
        </stack>
        <skeleton id="skeleton_card_image" width="250" height="125" rounded="md" />
      </stack>
      <code-editor
        id="skeleton_code_profile"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="10"
        default-value="{{ profile_code }}"
      />
    </component-example>

    <component-example label="Secondary Variant">
      <stack id="skeleton_secondary_stack" direction="vertical" spacing="8" align="start">
        <skeleton id="skeleton_subtle_bar" width="200" secondary="true" />
        <skeleton id="skeleton_subtle_line" width="180" secondary="true" />
      </stack>
      <code-editor
        id="skeleton_code_secondary"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="4"
        default-value="{{ secondary_code }}"
      />
    </component-example>

    <table slot="properties" stripe="true">
      <table-header>
        <table-column field="name" width="120">Attribute</table-column>
        <table-column field="type" width="90">Type</table-column>
        <table-column field="default" width="110">Default</table-column>
        <table-column field="description" width="560">Description</table-column>
      </table-header>
      <table-row>
        <table-cell><label size="sm" text="secondary" /></table-cell>
        <table-cell>bool</table-cell>
        <table-cell>false</table-cell>
        <table-cell>Render at 50% opacity of the skeleton color for a subtler placeholder.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="width" /></table-cell>
        <table-cell>integer</table-cell>
        <table-cell>full</table-cell>
        <table-cell>Width in px; defaults to full width.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="height" /></table-cell>
        <table-cell>integer</table-cell>
        <table-cell>16</table-cell>
        <table-cell>Height in px.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="rounded" /></table-cell>
        <table-cell>string</table-cell>
        <table-cell>—</table-cell>
        <table-cell>Corner preset: sm/md/lg/xl/full.</table-cell>
      </table-row>
    </table>
  </component-page>
</template>
