<!-- rating.nemo — placeholder page for the gpui-kit Rating component. Not yet
     wrapped by nemo; the status block below goes away once examples are added. -->
<template name="component-page-rating">
  <component-page name="Rating" description="A simple star rating element.">
    <stack id="rating_status" direction="vertical" spacing="4" align="start">
      <label id="rating_not_implemented" text="Not implemented" size="lg" />
      <label id="rating_source" text="Source: https://gpui-kit.com/component/rating" size="sm" />
    </stack>
  </component-page>
</template>
