<script>
let basic_code = #"<rating id="product" value="3" max="5" on-click="handle_rating" />"#;

let sizes_code = #"<rating id="r_xsmall" size="xsmall" value="3" max="5" />
<rating id="r_small" size="small" value="3" max="5" />
<rating id="r_large" size="large" value="3" max="5" />"#;

let colors_code = #"<rating id="r_success" value="4" max="5" color="theme.success" />
<rating id="r_warning" value="2" max="5" color="theme.warning" />
<rating id="r_danger" value="1" max="5" color="theme.danger" />"#;

let max_code = #"<rating id="r_ten" value="7" max="10" />"#;

let readonly_code = #"<rating id="r_review" value="4" max="5" disabled="true" />"#;
</script>

<!-- menu rating note: the kit owns the current value in its own keyed state
     (seeded from value, reset when the prop changes); on-click receives the
     new rating so the app can persist it. -->
<template name="component-page-rating">
  <component-page name="Rating" description="A star rating row. Clicking an unfilled star sets the value and clicking a filled star steps it down by one; hover previews the would-be value. The active color defaults to the theme's yellow.">
    <component-example label="Basic">
      <stack id="rating_basic_stack" direction="vertical" spacing="16" align="start">
        <rating id="rating_basic" value="3" max="5" />
        <rating id="rating_unset" value="0" max="5" />
      </stack>
      <code-editor
        id="rating_code_basic"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="2"
        default-value="{{ basic_code }}"
      />
    </component-example>

    <component-example label="Sizes">
      <stack id="rating_sizes_stack" direction="vertical" spacing="12" align="start">
        <rating id="rating_xsmall" size="xsmall" value="3" max="5" />
        <rating id="rating_small" size="small" value="3" max="5" />
        <rating id="rating_medium" value="3" max="5" />
        <rating id="rating_large" size="large" value="3" max="5" />
      </stack>
      <code-editor
        id="rating_code_sizes"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="5"
        default-value="{{ sizes_code }}"
      />
    </component-example>

    <component-example label="Colors">
      <stack id="rating_colors_stack" direction="vertical" spacing="12" align="start">
        <rating id="rating_other" value="5" max="5" color="theme.primary" />
        <rating id="rating_success" value="4" max="5" color="theme.success" />
        <rating id="rating_warning" value="2" max="5" color="theme.warning" />
        <rating id="rating_danger" value="1" max="5" color="theme.danger" />
      </stack>
      <code-editor
        id="rating_code_colors"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="5"
        default-value="{{ colors_code }}"
      />
    </component-example>

    <component-example label="Custom Maximum">
      <stack id="rating_max_stack" direction="vertical" spacing="16" align="start">
        <rating id="rating_ten" value="7" max="10" />
        <rating id="rating_max" value="7" max="7" />
      </stack>
      <code-editor
        id="rating_code_max"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="3"
        default-value="{{ max_code }}"
      />
    </component-example>

    <component-example label="Read-only">
      <stack id="rating_ro_stack" direction="vertical" spacing="16" align="start">
        <rating id="rating_ro" value="4" max="5" disabled="true" />
      </stack>
      <code-editor
        id="rating_code_ro"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="2"
        default-value="{{ readonly_code }}"
      />
    </component-example>

    <table slot="properties" stripe="true">
      <table-header>
        <table-column field="name" width="130">Attribute</table-column>
        <table-column field="type" width="90">Type</table-column>
        <table-column field="default" width="110">Default</table-column>
        <table-column field="description" width="560">Description</table-column>
      </table-header>
      <table-row>
        <table-cell><label size="sm" text="value" /></table-cell>
        <table-cell>integer</table-cell>
        <table-cell>0</table-cell>
        <table-cell>Initial rating, clamped to 0..=max; the kit owns the value afterwards and re-seeds when the prop changes.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="max" /></table-cell>
        <table-cell>integer</table-cell>
        <table-cell>5</table-cell>
        <table-cell>Number of stars.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="size" /></table-cell>
        <table-cell>string</table-cell>
        <table-cell>medium</table-cell>
        <table-cell>Star size: xsmall, small, medium, or large.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="color" /></table-cell>
        <table-cell>string</table-cell>
        <table-cell>theme yellow</table-cell>
        <table-cell>Active star color: theme.* reference or hex.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="disabled" /></table-cell>
        <table-cell>boolean</table-cell>
        <table-cell>false</table-cell>
        <table-cell>Read-only display.</table-cell>
      </table-row>
    </table>

    <table slot="callbacks" stripe="true">
      <table-header>
        <table-column field="name" width="130">Handler</table-column>
        <table-column field="arg" width="120">Argument</table-column>
        <table-column field="description" width="600">Description</table-column>
      </table-header>
      <table-row>
        <table-cell><label size="sm" text="on-click" /></table-cell>
        <table-cell>value (string)</table-cell>
        <table-cell>Invoked when a star is clicked with the new rating value; clicking a filled star steps the value down by one.</table-cell>
      </table-row>
    </table>
  </component-page>
</template>
