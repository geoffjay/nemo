<script>
let basic_code = #"<stepper id="wizard" selected-index="1">
  <stepper-item label="Account" />
  <stepper-item label="Profile" />
  <stepper-item label="Confirmation" />
</stepper>"#;

let icons_code = #"<stepper id="order" selected-index="2">
  <stepper-item icon="calendar" label="Order Details" />
  <stepper-item icon="inbox" label="Shipping" />
  <stepper-item icon="frame" label="Preview" />
  <stepper-item icon="info" label="Finish" />
</stepper>"#;

let vertical_code = #"<stack direction="horizontal" spacing="40">
  <stepper id="pipeline" layout="vertical" selected-index="2">
    <stepper-item icon="building-2" label="Step 1">
      <label size="sm" text="Description for step 1." />
    </stepper-item>
    <stepper-item icon="asterisk" label="Step 2">
      <label size="sm" text="Description for step 2." />
    </stepper-item>
    <stepper-item icon="folder" label="Step 3">
      <label size="sm" text="Description for step 3." />
    </stepper-item>
    <stepper-item icon="circle-check" label="Step 4">
      <label size="sm" text="Description for step 4." />
    </stepper-item>
  </stepper>
</stack>"#;

let states_code = #"<stepper id="disabled_all" disabled="true" selected-index="1">
  <stepper-item label="Step 1" />
  <stepper-item label="Step 2" />
</stepper>

<stepper id="locked_step" selected-index="0">
  <stepper-item label="Available" />
  <stepper-item label="Locked" disabled="true" />
  <stepper-item label="Available" />
</stepper>"#;
</script>

<!-- stepper.nemo — component reference page for the stepper wrapper of
     gpui-kit's Stepper. Steps come from <stepper-item> children; steps before
     selected-index render as completed. on-click fires with the clicked step
     index as the event data. -->
<template name="component-page-stepper">
  <component-page name="Stepper" description="A step-by-step progress for navigating through a series of steps or stages. Supports horizontal and vertical layouts, custom icons, and disabled steps.">
    <component-example label="Basic">
      <stepper id="stepper_wizard" selected-index="1">
        <stepper-item id="stepper_wizard_account" label="Account" />
        <stepper-item id="stepper_wizard_profile" label="Profile" />
        <stepper-item id="stepper_wizard_confirm" label="Confirmation" />
      </stepper>
      <code-editor
        id="stepper_code_basic"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="5"
        default-value="{{ basic_code }}"
      />
    </component-example>

    <component-example label="With Icons">
      <stepper id="stepper_order" selected-index="2">
        <stepper-item id="stepper_order_details" icon="calendar" label="Order Details" />
        <stepper-item id="stepper_order_shipping" icon="inbox" label="Shipping" />
        <stepper-item id="stepper_order_preview" icon="frame" label="Preview" />
        <stepper-item id="stepper_order_finish" icon="info" label="Finish" />
      </stepper>
      <code-editor
        id="stepper_code_icons"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="6"
        default-value="{{ icons_code }}"
      />
    </component-example>

    <component-example label="Vertical Layout">
      <stepper id="stepper_pipeline" layout="vertical" selected-index="2" width="360">
        <stepper-item id="stepper_pipeline_one" icon="building-2" label="Step 1">
          <label id="stepper_pipeline_one_desc" size="sm" text="Description for step 1." />
        </stepper-item>
        <stepper-item id="stepper_pipeline_two" icon="asterisk" label="Step 2">
          <label id="stepper_pipeline_two_desc" size="sm" text="Description for step 2." />
        </stepper-item>
        <stepper-item id="stepper_pipeline_three" icon="folder" label="Step 3">
          <label id="stepper_pipeline_three_desc" size="sm" text="Description for step 3." />
        </stepper-item>
        <stepper-item id="stepper_pipeline_four" icon="circle-check" label="Step 4">
          <label id="stepper_pipeline_four_desc" size="sm" text="Description for step 4." />
        </stepper-item>
      </stepper>
      <code-editor
        id="stepper_code_vertical"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="14"
        default-value="{{ vertical_code }}"
      />
    </component-example>

    <component-example label="Disabled Steps">
      <stack id="stepper_disabled_stack" direction="vertical" spacing="16">
        <stepper id="stepper_disabled_all" disabled="true" selected-index="1">
          <stepper-item id="stepper_disabled_one" label="Step 1" />
          <stepper-item id="stepper_disabled_two" label="Step 2" />
        </stepper>
        <stepper id="stepper_locked_step" selected-index="0">
          <stepper-item id="stepper_locked_one" label="Available" />
          <stepper-item id="stepper_locked_two" label="Locked" disabled="true" />
          <stepper-item id="stepper_locked_three" label="Available" />
        </stepper>
      </stack>
      <code-editor
        id="stepper_code_disabled"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="8"
        default-value="{{ states_code }}"
      />
    </component-example>

    <table slot="properties" stripe="true">
      <table-header>
        <table-column field="name" width="140">Attribute</table-column>
        <table-column field="type" width="90">Type</table-column>
        <table-column field="default" width="120">Default</table-column>
        <table-column field="description" width="540">Description</table-column>
      </table-header>
      <table-row>
        <table-cell><label size="sm" text="selected-index" /></table-cell>
        <table-cell>integer</table-cell>
        <table-cell>0</table-cell>
        <table-cell>Current step, 0-based; steps before it render as completed.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="layout" /></table-cell>
        <table-cell>string</table-cell>
        <table-cell>horizontal</table-cell>
        <table-cell>Step arrangement: horizontal or vertical.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="size" /></table-cell>
        <table-cell>string</table-cell>
        <table-cell>medium</table-cell>
        <table-cell>Control size: xsmall, small, medium, or large.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="text-center" /></table-cell>
        <table-cell>bool</table-cell>
        <table-cell>false</table-cell>
        <table-cell>Center the text within each step item.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="disabled" /></table-cell>
        <table-cell>bool</table-cell>
        <table-cell>false</table-cell>
        <table-cell>Disable every step.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="on-click" /></table-cell>
        <table-cell>string</table-cell>
        <table-cell>—</table-cell>
        <table-cell>Handler invoked with the clicked step index as event data.</table-cell>
      </table-row>
    </table>

    <table slot="callbacks" stripe="true">
      <table-header>
        <table-column field="name" width="140">Handler</table-column>
        <table-column field="event" width="120">Event Data</table-column>
        <table-column field="description" width="610">Description</table-column>
      </table-header>
      <table-row>
        <table-cell><label size="sm" text="on-click" /></table-cell>
        <table-cell>step index</table-cell>
        <table-cell>Fires when a step is clicked; the payload is the 0-based step index.</table-cell>
      </table-row>
    </table>
  </component-page>
</template>