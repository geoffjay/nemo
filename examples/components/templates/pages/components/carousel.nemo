<script>
let basic_code = #"<carousel id="projects" width="480" height="120" on-change="handle_slide_changed">
  <stack id="p1" direction="vertical" align="center" justify="center">
    <label id="p1_text" size="lg" text="Project one" />
  </stack>
  <stack id="p2" direction="vertical" align="center" justify="center">
    <label id="p2_text" size="lg" text="Project two" />
  </stack>
  <stack id="p3" direction="vertical" align="center" justify="center">
    <label id="p3_text" size="lg" text="Project three" />
  </stack>
</carousel>"#;

let pagination_code = #"<carousel id="pager" width="480" height="120" controls="false" pagination="true">
  <stack id="pg1" direction="vertical" align="center" justify="center">
    <label id="pg1_text" size="lg" text="Slide 1 of 3" />
  </stack>
  <stack id="pg2" direction="vertical" align="center" justify="center">
    <label id="pg2_text" size="lg" text="Slide 2 of 3" />
  </stack>
  <stack id="pg3" direction="vertical" align="center" justify="center">
    <label id="pg3_text" size="lg" text="Slide 3 of 3" />
  </stack>
</carousel>"#;

let vertical_code = #"<carousel id="vertical" width="480" height="220" axis="vertical" controls="false" pagination="true">
  <stack id="v1" direction="vertical" align="center" justify="center">
    <label id="v1_text" size="lg" text="Row one" />
  </stack>
  <stack id="v2" direction="vertical" align="center" justify="center">
    <label id="v2_text" size="lg" text="Row two" />
  </stack>
  <stack id="v3" direction="vertical" align="center" justify="center">
    <label id="v3_text" size="lg" text="Row three" />
  </stack>
</carousel>"#;

let looping_code = #"<carousel id="looping" width="480" height="120" looping="true" index="2">
  <stack id="l1" direction="vertical" align="center" justify="center">
    <label id="l1_text" size="lg" text="First" />
  </stack>
  <stack id="l2" direction="vertical" align="center" justify="center">
    <label id="l2_text" size="lg" text="Second" />
  </stack>
  <stack id="l3" direction="vertical" align="center" justify="center">
    <label id="l3_text" size="lg" text="Third" />
  </stack>
</carousel>"#;
</script>

<!-- carousel note: the slides are the declarative children in order; the
     selection lives in a shared CarouselState entity in the app (seeded from
     index, restartable via a script-set index), swipes/wheel/keyboard/controls
     all drive it, and every selection fires on-change with the new index. -->
<template name="component-page-carousel">
  <component-page name="Carousel" description="Displays one or more related items in a snapping viewport. Supports horizontal and vertical layouts, keyboard navigation, pointer and trackpad gestures, looping, and a controlled selection. The prev/next controls disable themselves at the boundaries.">
    <component-example label="Basic">
      <stack id="carousel_basic_stack" direction="vertical" spacing="16">
        <carousel id="carousel_basic" width="480" height="120" on-change="handle_slide_changed">
          <stack id="carousel_s1" direction="vertical" align="center" justify="center">
            <label id="carousel_s1_text" size="lg" text="Project one" />
          </stack>
          <stack id="carousel_s2" direction="vertical" align="center" justify="center">
            <label id="carousel_s2_text" size="lg" text="Project two" />
          </stack>
          <stack id="carousel_s3" direction="vertical" align="center" justify="center">
            <label id="carousel_s3_text" size="lg" text="Project three" />
          </stack>
        </carousel>
      </stack>
      <code-editor
        id="carousel_code_basic"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="16"
        default-value="{{ basic_code }}"
      />
    </component-example>

    <component-example label="Pagination Indicators">
      <stack id="carousel_pagination_stack" direction="vertical" spacing="16">
        <carousel id="carousel_pager" width="480" height="120" controls="false" pagination="true">
          <stack id="carousel_pg1" direction="vertical" align="center" justify="center">
            <label id="carousel_pg1_text" size="lg" text="Slide 1 of 3" />
          </stack>
          <stack id="carousel_pg2" direction="vertical" align="center" justify="center">
            <label id="carousel_pg2_text" size="lg" text="Slide 2 of 3" />
          </stack>
          <stack id="carousel_pg3" direction="vertical" align="center" justify="center">
            <label id="carousel_pg3_text" size="lg" text="Slide 3 of 3" />
          </stack>
        </carousel>
      </stack>
      <code-editor
        id="carousel_code_pagination"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="16"
        default-value="{{ pagination_code }}"
      />
    </component-example>

    <component-example label="Vertical Orientation">
      <stack id="carousel_vertical_stack" direction="vertical" spacing="16">
        <carousel id="carousel_vertical" width="480" height="220" axis="vertical" controls="false" pagination="true">
          <stack id="carousel_v1" direction="vertical" align="center" justify="center">
            <label id="carousel_v1_text" size="lg" text="Row one" />
          </stack>
          <stack id="carousel_v2" direction="vertical" align="center" justify="center">
            <label id="carousel_v2_text" size="lg" text="Row two" />
          </stack>
          <stack id="carousel_v3" direction="vertical" align="center" justify="center">
            <label id="carousel_v3_text" size="lg" text="Row three" />
          </stack>
        </carousel>
      </stack>
      <code-editor
        id="carousel_code_vertical"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="16"
        default-value="{{ vertical_code }}"
      />
    </component-example>

    <component-example label="Looping">
      <stack id="carousel_loop_stack" direction="vertical" spacing="16">
        <carousel id="carousel_looping" width="480" height="120" looping="true" index="2">
          <stack id="carousel_l1" direction="vertical" align="center" justify="center">
            <label id="carousel_l1_text" size="lg" text="First" />
          </stack>
          <stack id="carousel_l2" direction="vertical" align="center" justify="center">
            <label id="carousel_l2_text" size="lg" text="Second" />
          </stack>
          <stack id="carousel_l3" direction="vertical" align="center" justify="center">
            <label id="carousel_l3_text" size="lg" text="Third" />
          </stack>
        </carousel>
      </stack>
      <code-editor
        id="carousel_code_looping"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="16"
        default-value="{{ looping_code }}"
      />
    </component-example>

    <table slot="properties" stripe="true">
      <table-header>
        <table-column field="name" width="130">Attribute</table-column>
        <table-column field="type" width="90">Type</table-column>
        <table-column field="default" width="110">Default</table-column>
        <table-column field="description" width="560">Description</table-column>
      </table-header>
      <table-row>
        <table-cell><label size="sm" text="height" /></table-cell>
        <table-cell>integer</table-cell>
        <table-cell>—</table-cell>
        <table-cell>Slide height in px. Give the viewport a definite height so snapping and vertical carousels work.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="axis" /></table-cell>
        <table-cell>string</table-cell>
        <table-cell>horizontal</table-cell>
        <table-cell>Orientation: horizontal (arrows Left/Right) or vertical (arrows Up/Down).</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="looping" /></table-cell>
        <table-cell>boolean</table-cell>
        <table-cell>false</table-cell>
        <table-cell>Wrap navigation from the last slide to the first.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="index" /></table-cell>
        <table-cell>integer</table-cell>
        <table-cell>0</table-cell>
        <table-cell>Initially selected slide, zero-based. Changing the property re-seeds the selection.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="controls" /></table-cell>
        <table-cell>boolean</table-cell>
        <table-cell>true</table-cell>
        <table-cell>Render the prev/next chevron buttons; they auto-disable at the boundaries.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="pagination" /></table-cell>
        <table-cell>boolean</table-cell>
        <table-cell>false</table-cell>
        <table-cell>Render a numbered compact-button row under the viewport; each button selects its slide.</table-cell>
      </table-row>
    </table>

    <table slot="callbacks" stripe="true">
      <table-header>
        <table-column field="name" width="130">Handler</table-column>
        <table-column field="arg" width="120">Argument</table-column>
        <table-column field="description" width="600">Description</table-column>
      </table-header>
      <table-row>
        <table-cell><label size="sm" text="on-change" /></table-cell>
        <table-cell>index (string)</table-cell>
        <table-cell>Invoked when user navigation selects a slide (swipe, wheel, keyboard, or controls) with the zero-based index as a string; programmatic index changes do not fire it.</table-cell>
      </table-row>
    </table>
  </component-page>
</template>
