<script>
let default_code = #"<attachment id="report">
  <attachment-media icon="file-text" />
  <attachment-content title="quarterly-report.pdf" description="PDF · 2.4 MB" />
  <attachment-actions>
    <button id="att-remove" label="Remove" variant="ghost" size="xs" />
  </attachment-actions>
</attachment>"#;

let sizes_code = #"<attachment id="report-sm" size="sm">
  <attachment-media icon="file-text" />
  <attachment-content title="small.pdf" description="PDF · 1.1 MB" />
</attachment>

<attachment id="report-lg" size="lg">
  <attachment-media icon="frame" />
  <attachment-content title="photo.png" description="PNG · 12.6 MB" />
</attachment>"#;

let statuses_code = #"<attachment id="ready" status="pending">
  <attachment-media icon="file" />
  <attachment-content title="draft.md" description="Ready to upload" />
</attachment>

<attachment id="upload" status="uploading" progress="62">
  <attachment-media />
  <attachment-content title="dataset.csv" description="Uploading" />
</attachment>

<attachment id="failed" status="failed" tooltip="Image exceeds the 20 MB limit">
  <attachment-media icon="triangle-alert" />
  <attachment-content title="artwork.png" description="Upload failed" />
</attachment>"#;

let vertical_code = #"<attachment id="preview" axis="vertical" size="lg" on-click="on_attachment_click_demo">
  <attachment-media src="https://picsum.photos/seed/attachment/320/320" />
  <attachment-content title="landscape.jpg" description="JPG · 1920 × 1080" />
  <attachment-actions>
    <button id="att-vertical-remove" label="Remove" variant="ghost" size="xs" />
  </attachment-actions>
</attachment>"#;

let callbacks_code = ##"<attachment id="artwork" status="failed" on-click="on_attachment_click" on-remove="on_attachment_remove" on-retry="on_attachment_retry">
  <attachment-media icon="frame" />
  <attachment-content title="artwork.png" description="Upload failed · tap to retry" />
</attachment>

# handlers.rhai
# Every handler receives (component_id, event_data).
fn on_attachment_click(component_id, event_data) {
  set_component_property("attachment_status_text", "content", "Opened preview of " + component_id);
}
fn on_attachment_remove(component_id, event_data) {
  set_component_property("attachment_status_text", "content", "Removed " + component_id);
}
fn on_attachment_retry(component_id, event_data) {
  set_component_property("attachment_status_text", "content", "Retrying " + component_id);
}"##;

// Attachment page callback demo: reports which built-in control fired.
fn on_attachment_click_demo(component_id, event_data) {
    set_component_property(
      "attachment_vertical_status",
      "content",
      "Card clicked: " + component_id
    );
}

fn on_attachment_cb_demo(component_id, event_data) {
    set_component_property(
      "attachment_cb_status",
      "content",
      "Last event: " + event_data + " on " + component_id
    );
}
</script>

<template name="component-page-attachment">
  <component-page name="Attachment" description="File attachment cards with status and a remove control. Composed from a media preview, metadata, and an actions slot — built-in remove, retry, and whole-card click controls stay consistent across the app.">
    <component-example label="Default">
      <stack direction="horizontal" spacing="16">
        <attachment id="attachment_default_demo">
          <attachment-media icon="file-text" />
          <attachment-content title="quarterly-report.pdf" description="PDF · 2.4 MB" />
          <attachment-actions>
            <button id="attachment_default_remove" label="Remove" variant="ghost" size="xs" />
          </attachment-actions>
        </attachment>
      </stack>
      <code-editor
        id="attachment_code_default"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="8"
        default-value="{{ default_code }}"
      />
    </component-example>

    <component-example label="Sizes">
      <stack direction="vertical" spacing="16" align="start">
        <attachment id="attachment_size_sm" size="sm">
          <attachment-media icon="file-text" />
          <attachment-content title="small.pdf" description="PDF · 1.1 MB" />
        </attachment>
        <attachment id="attachment_size_lg" size="lg">
          <attachment-media icon="frame" />
          <attachment-content title="photo.png" description="PNG · 12.6 MB" />
        </attachment>
      </stack>
      <code-editor
        id="attachment_code_sizes"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="10"
        default-value="{{ sizes_code }}"
      />
    </component-example>

    <component-example label="Lifecycle Statuses">
      <stack direction="vertical" spacing="16" align="start">
        <attachment id="attachment_status_pending" status="pending">
          <attachment-media icon="file" />
          <attachment-content title="draft.md" description="Ready to upload" />
        </attachment>
        <attachment id="attachment_status_uploading" status="uploading" progress="62">
          <attachment-media />
          <attachment-content title="dataset.csv" description="Uploading" />
        </attachment>
        <attachment id="attachment_status_failed" status="failed" tooltip="Image exceeds the 20 MB limit">
          <attachment-media icon="triangle-alert" />
          <attachment-content title="artwork.png" description="Upload failed" />
        </attachment>
      </stack>
      <code-editor
        id="attachment_code_statuses"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="13"
        default-value="{{ statuses_code }}"
      />
    </component-example>

    <component-example label="Vertical Preview Card">
      <stack direction="vertical" spacing="16" align="start">
        <attachment id="attachment_vertical_demo" axis="vertical" size="lg" on-click="on_attachment_click_demo">
          <attachment-media src="https://picsum.photos/seed/attachment/320/320" />
          <attachment-content title="landscape.jpg" description="JPG · 1920 × 1080" />
          <attachment-actions>
            <button id="attachment_vertical_remove" label="Remove" variant="ghost" size="xs" />
          </attachment-actions>
        </attachment>
        <text id="attachment_vertical_status" content="Card clicked: none" />
      </stack>
      <code-editor
        id="attachment_code_vertical"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="9"
        default-value="{{ vertical_code }}"
      />
    </component-example>

    <table slot="properties" stripe="true">
      <table-header>
        <table-column field="name" width="140">Attribute</table-column>
        <table-column field="type" width="90">Type</table-column>
        <table-column field="default" width="110">Default</table-column>
        <table-column field="description" width="520">Description</table-column>
      </table-header>
      <table-row>
        <table-cell><label size="sm" text="status" /></table-cell>
        <table-cell>string</table-cell>
        <table-cell>complete</table-cell>
        <table-cell>Lifecycle state: pending (dashed border), uploading, processing, failed (destructive border), or complete.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="axis" /></table-cell>
        <table-cell>string</table-cell>
        <table-cell>horizontal</table-cell>
        <table-cell>Layout direction: horizontal shares one row; vertical stacks the preview above the metadata.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="size" /></table-cell>
        <table-cell>string</table-cell>
        <table-cell>md</table-cell>
        <table-cell>Chip density: xs, sm, md, or lg — sets height, width, media, and text scale together.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="progress" /></table-cell>
        <table-cell>float</table-cell>
        <table-cell>—</table-cell>
        <table-cell>Upload percent 0–100. While uploading, turns the spinner into a determinate ring and draws a bar along the card's bottom edge.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="tooltip" /></table-cell>
        <table-cell>string</table-cell>
        <table-cell>—</table-cell>
        <table-cell>Hover text, e.g. the reason a failure or rejection happened.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="attachment-media" /></table-cell>
        <table-cell>slot</table-cell>
        <table-cell>—</table-cell>
        <table-cell>Preview area with src (image cover) or icon (named glyph); children paint above it. Omitted while uploading or failed: the slot shows the status treatment itself. Attributes: src, icon.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="attachment-content" /></table-cell>
        <table-cell>slot</table-cell>
        <table-cell>—</table-cell>
        <table-cell>Metadata stack: one-line title and description that follow the card status; children append badges or progress. Attributes: title, description.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="attachment-actions" /></table-cell>
        <table-cell>slot</table-cell>
        <table-cell>—</table-cell>
        <table-cell>Controls such as buttons or links; ordinary child components with their own handlers.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="children" /></table-cell>
        <table-cell>—</table-cell>
        <table-cell>—</table-cell>
        <table-cell>Typed slots as children: attachment-media, attachment-content, attachment-actions.</table-cell>
      </table-row>
    </table>

    <table slot="callbacks" stripe="true">
      <table-header>
        <table-column field="name" width="130">Handler</table-column>
        <table-column field="arg" width="120">Argument</table-column>
        <table-column field="description" width="600">Description</table-column>
      </table-header>
      <table-row>
        <table-cell><label size="sm" text="on-click" /></table-cell>
        <table-cell>event (string)</table-cell>
        <table-cell>Whole-card activation, e.g. to open a preview. Painted below the actions, so action buttons stay clickable.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="on-remove" /></table-cell>
        <table-cell>event (string)</table-cell>
        <table-cell>The built-in corner remove control, a small disc that appears on hover.</table-cell>
      </table-row>
      <table-row>
        <table-cell><label size="sm" text="on-retry" /></table-cell>
        <table-cell>event (string)</table-cell>
        <table-cell>The retry control, shown only while the status is failed: a round button over an image preview, else a Retry link after the description.</table-cell>
      </table-row>
    </table>

    <component-example label="on-remove / on-click" slot="callbacks">
      <stack direction="horizontal" spacing="8">
        <attachment id="attachment_cb_demo" status="failed" on-click="on_attachment_cb_demo" on-remove="on_attachment_cb_demo" on-retry="on_attachment_cb_demo">
          <attachment-media icon="frame" />
          <attachment-content title="artwork.png" description="Upload failed · hover to retry or remove" />
        </attachment>
      </stack>
      <text id="attachment_cb_status" content="Last event: none" />
      <code-editor
        id="attachment_code_callbacks"
        slot="code"
        language="html"
        line-number="true"
        searchable="false"
        rows="20"
        default-value="{{ callbacks_code }}"
      />
    </component-example>
  </component-page>
</template>
