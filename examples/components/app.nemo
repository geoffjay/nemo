<!-- Component Gallery -->
<!-- Interactive showcase of all Nemo components, hosted in an app-shell with
<!-- an Overview / Styling / Components section menu. -->
<app title="Nemo Component Gallery">
  <plugins>
    <plugin name="demo-settings" />
  </plugins>

  <window title="Component Gallery" width="1200" height="800">
    <header-bar github-url="https://github.com/geoffjay/nemo/tree/main/examples/components" theme-toggle="true">
      <menu-item label="Roundness - Square" icon="settings" on-click="on_menu_roundness_square" />
      <menu-item label="Roundness - Sharp" icon="settings" on-click="on_menu_roundness_sharp" />
      <menu-item label="Roundness - Default" icon="settings" on-click="on_menu_roundness_default" />
      <menu-item label="Roundness - Round" icon="settings" on-click="on_menu_roundness_round" />
    </header-bar>
    <footer-bar enabled="false" />
  </window>

  <theme name="nord" mode="dark" />
</app>

<script src="./scripts" />

<!-- Shared component-page layout SFCs (from ./templates) -->
<imports>
  <import src="./templates/component.nemo" />
  <import src="./templates/component-example.nemo" />
  <import src="./templates/content-page.nemo" />
  <import src="./templates/pages/overview.nemo" />
  <import src="./templates/pages/styling.nemo" />
  <import src="./templates/pages/components/button.nemo" />
  <import src="./templates/pages/components/accordion.nemo" />
  <import src="./templates/pages/components/alert.nemo" />
  <import src="./templates/pages/components/avatar.nemo" />
  <import src="./templates/pages/components/badge.nemo" />
  <import src="./templates/pages/components/charts.nemo" />
  <import src="./templates/pages/components/checkbox.nemo" />
  <import src="./templates/pages/components/code-editor.nemo" />
  <import src="./templates/pages/components/collapsible.nemo" />
  <import src="./templates/pages/components/dropdown-button.nemo" />
  <import src="./templates/pages/components/icon.nemo" />
  <import src="./templates/pages/components/image.nemo" />
  <import src="./templates/pages/components/input.nemo" />
  <import src="./templates/pages/components/label.nemo" />
  <import src="./templates/pages/components/list.nemo" />
  <import src="./templates/pages/components/modal.nemo" />
  <import src="./templates/pages/components/notification.nemo" />
  <import src="./templates/pages/components/panel.nemo" />
  <import src="./templates/pages/components/progress.nemo" />
  <import src="./templates/pages/components/radio.nemo" />
  <import src="./templates/pages/components/select.nemo" />
  <import src="./templates/pages/components/sidenavbar.nemo" />
  <import src="./templates/pages/components/slider.nemo" />
  <import src="./templates/pages/components/spinner.nemo" />
  <import src="./templates/pages/components/svg.nemo" />
  <import src="./templates/pages/components/switch.nemo" />
  <import src="./templates/pages/components/table.nemo" />
  <import src="./templates/pages/components/tag.nemo" />
  <import src="./templates/pages/components/text-editor.nemo" />
  <import src="./templates/pages/components/text.nemo" />
  <import src="./templates/pages/components/textarea.nemo" />
  <import src="./templates/pages/components/toggle.nemo" />
  <import src="./templates/pages/components/tooltip.nemo" />
  <import src="./templates/pages/components/tree.nemo" />
</imports>

<!-- Templates -->
<templates>
  <template name="page_content">
    <panel>
      <stack id="inner" direction="vertical" spacing="12" padding="32">
        <slot />
      </stack>
    </panel>
  </template>
</templates>

<template name="app">
  <!-- App shell: a sidenav of section menu items plus the gallery below. -->
  <app-shell id="app_shell" sidenav-width="220" default-page="overview">
    <app-sidenav>
      <sidenav-item id="nav_overview" icon="layout-dashboard" label="Overview" target="overview" />
      <sidenav-item id="nav_styling" icon="palette" label="Styling" target="styling" />
      <sidenav-item id="nav_components" icon="frame" label="Components" target="components" />
    </app-sidenav>

    <app-content>
      <overview id="overview" />
      <styling id="styling" />

      <!-- Components page: the original gallery navigation and router, intact. -->
      <page id="components">
        <stack id="root_row" direction="horizontal" spacing="0" flex="1" align="stretch">
          <panel id="sidebar" border="0">
            <stack id="sidebar_inner" direction="vertical" spacing="8" padding="16" scroll="true" border-right="1" border-color="theme.border">
              <!-- Basic -->
              <label id="cat_basic" text="Basic" size="sm" />
              <nav-link router="main" route="/accordion" label="Accordion" />
              <nav-link router="main" route="/alert" label="Alert" />
              <nav-link router="main" route="/avatar" label="Avatar" />
              <nav-link router="main" route="/badge" label="Badge" />
              <nav-link router="main" route="/button" label="Button" />
              <nav-link router="main" route="/checkbox" label="Checkbox" />
              <nav-link router="main" route="/collapsible" label="Collapsible" />
              <nav-link router="main" route="/dropdown-button" label="Dropdown Button" />
              <nav-link router="main" route="/icon" label="Icon" />
              <nav-link router="main" route="/image" label="Image" />
              <nav-link router="main" route="/label" label="Label" />
              <nav-link router="main" route="/progress" label="Progress" />
              <nav-link router="main" route="/spinner" label="Spinner" />
              <nav-link router="main" route="/tag" label="Tag" />
              <nav-link router="main" route="/text" label="Text" />
              <nav-link router="main" route="/tooltip" label="Tooltip" />

              <!-- Form -->
              <label id="cat_form" text="Form" size="sm" />
              <nav-link router="main" route="/code-editor" label="Code Editor" />
              <nav-link router="main" route="/input" label="Input" />
              <nav-link router="main" route="/radio" label="Radio" />
              <nav-link router="main" route="/select" label="Select" />
              <nav-link router="main" route="/slider" label="Slider" />
              <nav-link router="main" route="/switch" label="Switch" />
              <nav-link router="main" route="/text-editor" label="Text Editor" />
              <nav-link router="main" route="/textarea" label="Textarea" />
              <nav-link router="main" route="/toggle" label="Toggle" />

              <!-- Layout -->
              <label id="cat_layout" text="Layout" size="sm" />
              <nav-link router="main" route="/list" label="List" />
              <nav-link router="main" route="/modal" label="Modal" />
              <nav-link router="main" route="/notification" label="Notification" />
              <nav-link router="main" route="/panel" label="Panel &amp; Stack" />

              <!-- Advanced -->
              <label id="cat_advanced" text="Advanced" size="sm" />
              <nav-link router="main" route="/charts" label="Charts" />
              <nav-link router="main" route="/svg" label="SVG" />
              <nav-link router="main" route="/table" label="Table" />
              <nav-link router="main" route="/tree" label="Tree" />

              <!-- Navigation -->
              <label id="cat_navigation" text="Navigation" size="sm" />
              <nav-link router="main" route="/sidenavbar" label="Sidenav Bar" />
            </stack>
          </panel>

          <stack id="content" direction="vertical" spacing="0" padding="16" scroll="true">
            <router id="main" default="/accordion" primary="true">
              <route path="/button"><component-page-button /></route>
              <route path="/label"><component-page-label /></route>
              <route path="/icon"><component-page-icon /></route>
              <route path="/checkbox"><component-page-checkbox /></route>
              <route path="/input"><component-page-input /></route>
              <route path="/textarea"><component-page-textarea /></route>
              <route path="/code-editor"><component-page-code-editor /></route>
              <route path="/text-editor"><component-page-text-editor /></route>
              <route path="/select"><component-page-select /></route>
              <route path="/progress"><component-page-progress /></route>
              <route path="/notification"><component-page-notification /></route>
              <route path="/modal"><component-page-modal /></route>
              <route path="/text"><component-page-text /></route>
              <route path="/list"><component-page-list /></route>
              <route path="/panel"><component-page-panel /></route>
              <route path="/table"><component-page-table /></route>
              <route path="/tree"><component-page-tree /></route>
              <route path="/image"><component-page-image /></route>
              <route path="/charts"><component-page-charts /></route>
              <route path="/svg"><component-page-svg /></route>
              <route path="/accordion"><component-page-accordion /></route>
              <route path="/alert"><component-page-alert /></route>
              <route path="/avatar"><component-page-avatar /></route>
              <route path="/badge"><component-page-badge /></route>
              <route path="/collapsible"><component-page-collapsible /></route>
              <route path="/dropdown-button"><component-page-dropdown-button /></route>
              <route path="/spinner"><component-page-spinner /></route>
              <route path="/tag"><component-page-tag /></route>
              <route path="/tooltip"><component-page-tooltip /></route>
              <route path="/radio"><component-page-radio /></route>
              <route path="/slider"><component-page-slider /></route>
              <route path="/switch"><component-page-switch /></route>
              <route path="/toggle"><component-page-toggle /></route>
              <route path="/sidenavbar"><component-page-sidenavbar /></route>
            </router>
          </stack>
        </stack>
      </page>
    </app-content>
  </app-shell>
</template>
