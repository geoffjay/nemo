<!-- Task List -->
<!-- A todo application backed entirely by a JSON file. The list starts empty on -->
<!-- first run; tasks are added through a modal, checked off / deleted by row     -->
<!-- number, and every change is written straight back to tasks.json.            -->
<!-- Full-screen, nord theme, with a centered card.                              -->
  <app title="Nemo Task List">
    <!-- No width/height on <window> => the window opens maximized (full screen). -->
    <window title="Task List">
      <header-bar github-url="https://github.com/geoffjay/nemo/tree/main/examples/task-list"
                  theme-toggle="true" />
    </window>
    <theme name="nord" mode="dark" />
  </app>

  <!--
    file-io  → rhai-fs, for reading/writing tasks.json.
    on-load  → run `on_load` once after the layout is built, so the table is
               hydrated from tasks.json before the first paint (no default list
               baked into the XML, and no state revealed lazily on first click).
  -->
  <script src="./scripts" features="file-io" on-load="on_load" />

  <!--
    Layout notes
    ============
    center_row grows (flex="1") to fill the window and justify="center" centers
    the card horizontally; the default vertical centering on a horizontal stack
    centers it vertically. The card itself is content-sized.
  -->
  <template name="app">
  <stack id="root" direction="vertical">
    <stack id="center_row" direction="horizontal" flex="1" justify="center">
      <panel id="task_card" width="860" padding="24" border="1" rounded="lg">
        <stack id="card_inner" direction="vertical" spacing="16">

          <!-- Title row: heading + live task count on the left, Add on the right -->
          <stack id="card_header" direction="horizontal" justify="between">
            <stack id="title_group" direction="horizontal" spacing="12">
              <label id="title" text="Tasks" size="xl" />
              <label id="task_count" text="0 tasks" size="sm" />
            </stack>
            <button id="add_button" label="+ Add Task" variant="primary" on-click="open_add_modal" />
          </stack>

          <!-- The task table. Rows are supplied as a data array by the handler
               script (set_component_property "tasks_table" "data" …); the cells
               are text-only, so "done" shows as a ✓ glyph rather than a live
               checkbox. -->
          <table id="tasks_table" height="440" stripe="true" bordered="true"
                 columns='[
                   {"key":"num","label":"#","width":48},
                   {"key":"done","label":"✓","width":48},
                   {"key":"label","label":"Task","width":420},
                   {"key":"due","label":"Due","width":180},
                   {"key":"status","label":"Status","width":130}
                 ]' />

          <!-- Row-level actions. Because table cells can't hold live controls,
               editing is keyed by the row number shown in the "#" column. -->
          <stack id="row_actions" direction="horizontal" spacing="12">
            <input id="row_num" placeholder="Row #" value="" width="90" />
            <button id="toggle_button" label="Toggle Done" variant="secondary" on-click="toggle_done" />
            <button id="delete_button" label="Delete" variant="danger" on-click="delete_task" />
            <label id="action_hint" text="Enter a row number, then Toggle or Delete." size="sm" />
          </stack>

        </stack>
      </panel>
    </stack>

    <!--
      Add-task modal. Opened by the "+ Add Task" button (open_add_modal), which
      also clears the fields. `submit_add` reads the two inputs' live `value`
      properties, appends a task, saves, and closes; pressing Enter in either
      field submits too (the input's on-change fires on Enter).
    -->
    <modal id="add_modal" title="Add a task" open="false">
      <text id="add_hint" content="Describe the task and (optionally) a due date." />
      <stack id="add_fields" direction="vertical" spacing="12">
        <input id="new_task_input" placeholder="Task description" value="" on-change="submit_add" />
        <input id="new_due_input" placeholder="Due date (YYYY-MM-DD, optional)" value="" on-change="submit_add" />
      </stack>
      <stack id="add_actions" direction="horizontal" spacing="12" justify="end">
        <button id="add_cancel" label="Cancel" variant="secondary" on-click="close_add_modal" />
        <button id="add_confirm" label="Add Task" variant="primary" on-click="submit_add" />
      </stack>
    </modal>
    </stack>
  </template>
