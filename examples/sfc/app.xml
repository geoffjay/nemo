<?xml version="1.0" encoding="UTF-8"?>
<!-- Single-File Components (.nemo SFCs) demo -->
<!-- Two reusable components live in ./components/*.nemo. Each is imported and    -->
<!-- used as a custom tag. <card> shows default-slot composition and per-instance -->
<!-- id scoping; <labeled-button> shows ${prop} interpolation and a scoped        -->
<!-- <script> handler that mutates the clicked instance.                          -->
<nemo>
  <app title="Nemo — Single-File Components">
    <window title="SFC Demo">
      <header-bar github-url="https://github.com/geoffjay/nemo/tree/main/examples/sfc"
                  theme-toggle="true" />
    </window>
    <theme name="nord" mode="dark" />
  </app>

  <imports>
    <import src="./components/card.nemo" />
    <import src="./components/labeled-button.nemo" />
  </imports>

  <layout type="stack">
    <stack id="root" direction="vertical" spacing="20" padding="32">
      <label id="title" text="Single-File Components" size="xl" />

      <!-- First card: the title targets the named `header` slot; the rest fill
           the default slot. -->
      <card>
        <label id="c1_title" slot="header" text="First card" size="lg" />
        <text id="c1_body" content="The title above went to the header slot; this went to the default slot." />
        <labeled-button id="btn_a" label="Press me" />
      </card>

      <!-- Second instance: its inner ids are scoped independently — no collision. -->
      <card>
        <label id="c2_title" slot="header" text="Second card" size="lg" />
        <text id="c2_body" content="A second instance, sharing the same .nemo definition." />
        <labeled-button id="btn_b" label="And me" />
      </card>
    </stack>
  </layout>
</nemo>
