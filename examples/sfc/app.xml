<?xml version="1.0" encoding="UTF-8"?>
<!-- Single-File Components (.nemo SFCs) demo -->
<!-- Two reusable components live in ./components/*.nemo. Each is imported and    -->
<!-- used as a custom tag. <card> shows default-slot composition and per-instance -->
<!-- id scoping; <labeled-button> shows ${prop} interpolation and a scoped        -->
<!-- <script> handler that mutates the clicked instance.                          -->
<nemo>
  <app title="Nemo — Single-File Components">
    <window title="SFC Demo">
      <header-bar github-url="https://github.com/geoffjay/nemo/tree/main/examples/sfc"
                  theme-toggle="true" />
    </window>
    <theme name="nord" mode="dark" />
  </app>

  <!-- Auto-discover every *.nemo in ./components (tags come from <template name>
       or the filename stem). Equivalent to listing each with <import>. -->
  <components dir="./components" />
  <script src="./scripts" />

  <layout type="stack">
    <stack id="root" direction="vertical" spacing="20" padding="32">
      <label id="title" text="Single-File Components" size="xl" />

      <!-- First card: the title targets the named `header` slot; the rest fill
           the default slot. -->
      <card>
        <label id="c1_title" slot="header" text="First card" size="lg" />
        <text id="c1_body" content="The title above went to the header slot; this went to the default slot." />
        <labeled-button id="btn_a" label="Press me" />
      </card>

      <!-- Second instance: its inner ids are scoped independently — no collision. -->
      <card>
        <label id="c2_title" slot="header" text="Second card" size="lg" />
        <text id="c2_body" content="A second instance, sharing the same .nemo definition." />
        <labeled-button id="btn_b" label="And me" />
      </card>

      <!-- Third: the button omits label/variant, so it renders the declared
           prop defaults ("Button", primary). -->
      <card>
        <label id="c3_title" slot="header" text="Prop defaults" size="lg" />
        <text id="c3_body" content="This button omits label and variant — both come from the SFC's declared prop defaults." />
        <labeled-button id="btn_c" />
      </card>

      <!-- Fourth: runtime component creation. The "Add label" button calls
           create_component to insert a label under this card's body stack;
           "Remove last" calls remove_component. The dynamic components appear
           and disappear without pre-declaring them in XML. -->
      <card>
        <label id="c4_title" slot="header" text="Runtime component creation" size="lg" />
        <text id="c4_body" content="Click 'Add label' to create a label at runtime via create_component; 'Remove last' tears it down with remove_component." />
        <stack id="c4_dynamic" direction="vertical" spacing="8" />
        <stack direction="horizontal" spacing="8">
          <button id="btn_add" label="Add label" variant="primary" on-click="on_add_label" />
          <button id="btn_remove" label="Remove last" variant="secondary" on-click="on_remove_label" />
        </stack>
      </card>
    </stack>
  </layout>
</nemo>
