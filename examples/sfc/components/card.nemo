<!--
  A reusable card container SFC with two slots and scoped styling.

  Slots: the `header` named slot receives consumer children tagged
  slot="header"; the default slot receives everything else. Each usage is
  expanded onto the template machinery, so the `head`/`body` stack ids are scoped
  per instance (e.g. body -> <instance>_body) — two cards never collide.

  Styling: the <style> block below is folded at compile time onto matching
  template nodes as inline attributes (type selector `panel`, id selector
  `#head`). It only reaches this SFC's own subtree. No CDATA is needed:
  `<style>` is parsed as a raw-text element, so the body is captured verbatim
  — `<` and `>` in the CSS (comments, future combinators) need no wrapper.
  (v1 style-folding supports type and #id selectors only; the raw-text parser
  itself captures any body regardless of selector syntax.)
-->
<template name="card">
  <panel border="1" border-color="theme.border">
    <stack id="head" direction="vertical" spacing="4">
      <!-- Required, single-value: every card must supply exactly one header. -->
      <slot name="header" required="true" multiple="false" />
    </stack>
    <stack id="body" direction="vertical" spacing="12">
      <slot />
    </stack>
  </panel>
</template>
<style>
  /* Folded onto the panel and #head at compile time; scoped to this card. */
  panel { padding: 20px; border-radius: lg; }
  #head { padding-bottom: 8px; }
</style>